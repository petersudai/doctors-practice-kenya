---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ChartTag from "../components/ChartTag.astro";
import BranchStatus from "../components/BranchStatus.astro";
import TrustStrip from "../components/TrustStrip.astro";
import StatsStrip from "../components/StatsStrip.astro";
import DoctorCard from "../components/DoctorCard.astro";
import ServiceCard from "../components/ServiceCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import BranchCard from "../components/BranchCard.astro";
import CTABand from "../components/CTABand.astro";
import { doctors, services, testimonials, branches, images } from "../data/site";

const featuredDoctors = doctors.slice(0, 3);
const featuredServices = services.slice(0, 4);
---

<Layout
  title="Family Medicine Across Kenya"
  description="Uzima Family Clinic offers same-week family medicine, paediatric care, dental and diagnostics across Nairobi, Mombasa and Kisumu. SHA, NHIF and M-Pesa accepted."
>
  <section class="bg-grain relative overflow-hidden bg-ink text-paper">
    <div class="mx-auto grid max-w-8xl grid-cols-1 gap-10 px-6 pb-0 pt-14 md:grid-cols-12 md:gap-4 md:px-10 md:pt-20">
      <div class="md:col-span-7 md:pb-24">
        <p class="font-mono-tag text-[11px] uppercase tracking-[0.1em] text-bone/70">
          <span class="text-clay">[</span>Karibu · Patient file since 2011<span class="text-clay">]</span>
        </p>
        <h1 class="mt-6 font-display text-[13vw] font-black leading-[0.86] tracking-tight text-balance sm:text-[9vw] md:text-[6.4vw]">
          Healthcare
          <br />
          that knows
          <br />
          your <span class="font-display-italic text-clay">name.</span>
        </h1>
        <p class="mt-8 max-w-md text-base leading-relaxed text-bone/80 md:text-lg">
          Three clinics across Kenya where the same doctor sees you every visit, your
          child's growth chart is never lost, and a same-week appointment is the default,
          not the exception.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a
            href="/contact"
            class="rounded-full bg-clay px-7 py-3.5 text-sm font-semibold text-paper transition-colors hover:bg-pulse"
          >
            Book an Appointment
          </a>
          <a
            href="/doctors"
            class="rounded-full border border-paper/25 px-7 py-3.5 text-sm font-semibold text-paper transition-colors hover:bg-paper/10"
          >
            Meet Our Doctors
          </a>
        </div>
        <BranchStatus />
        <div class="mt-10 flex items-center gap-4">
          <div class="flex -space-x-3">
            {
              testimonials.map((t) => (
                <img
                  src={t.photo}
                  alt={t.name}
                  class="h-9 w-9 rounded-full border-2 border-ink object-cover grayscale"
                />
              ))
            }
          </div>
          <p class="font-mono-tag text-[11px] uppercase tracking-[0.05em] text-bone/60">
            4.9/5 — 800+ patient reviews
          </p>
        </div>
      </div>

      <div class="relative md:col-span-5">
        <div class="relative aspect-[4/5] w-full overflow-hidden bg-ink-2 sm:aspect-[5/6] md:absolute md:inset-0 md:aspect-auto">
          <img
            src={images.heroHome}
            alt="A surgeon in blue scrubs at Uzima Family Clinic"
            class="h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/50 via-transparent to-transparent"></div>
        </div>
        <div class="absolute -bottom-px left-0 z-10 border border-line-dark bg-ink/90 p-5 backdrop-blur md:left-auto md:right-0">
          <p class="font-display text-3xl font-semibold text-clay">22,000+</p>
          <p class="font-mono-tag mt-1 text-[10px] uppercase tracking-[0.05em] text-bone/70">
            Patients treated across three counties
          </p>
        </div>
      </div>
    </div>

    <div class="mx-auto flex max-w-8xl items-center justify-between border-t border-line-dark px-6 py-4 md:px-10">
      <span class="font-mono-tag text-[11px] uppercase tracking-[0.05em] text-bone/50">Scroll</span>
      <span class="h-8 w-px animate-pulse bg-line-dark"></span>
      <span class="font-mono-tag text-[11px] uppercase tracking-[0.05em] text-bone/50">01 / Home</span>
    </div>
  </section>

  <TrustStrip />

  <section class="mx-auto max-w-8xl px-6 py-20 md:px-10 md:py-28">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end" data-reveal>
      <SectionHeading eyebrow="What we treat" title="Care built around the whole family" />
      <a href="/services" class="font-mono-tag text-[12px] uppercase tracking-[0.05em] text-clay hover:text-clay-dark">
        View all services →
      </a>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {featuredServices.map((service, i) => <ServiceCard service={service} index={i} />)}
    </div>
  </section>

  <section class="border-y border-line bg-paper-2">
    <div class="mx-auto grid max-w-8xl grid-cols-1 items-center gap-12 px-6 py-20 md:grid-cols-2 md:px-10 md:py-28">
      <div class="order-2 aspect-[4/3] overflow-hidden md:order-1" data-reveal>
        <img
          src={images.waitingRoom}
          alt="Uzima Family Clinic waiting room"
          class="h-full w-full object-cover grayscale-[20%]"
        />
      </div>
      <div class="order-1 md:order-2" data-reveal>
        <SectionHeading eyebrow="Why Uzima" title="Built by a doctor tired of ten-minute consultations" />
        <p class="mt-6 text-base leading-relaxed text-ink-2/80">
          Dr. Wanjiru Kamau opened the first Uzima branch in Kilimani after a decade in
          public hospitals, where good doctors were rushed and families rarely saw the
          same face twice. Every branch since has kept her original rule: no consultation
          shorter than twenty minutes, and no patient history that starts from zero.
        </p>
        <ul class="mt-6 space-y-3 border-t border-line pt-6">
          <li class="flex gap-3">
            <ChartTag label="01" />
            <span class="text-sm text-ink-2/80">
              Digital patient records shared across all three branches
            </span>
          </li>
          <li class="flex gap-3">
            <ChartTag label="02" />
            <span class="text-sm text-ink-2/80">
              On-site lab, pharmacy and dental suite, most visits resolved in one stop
            </span>
          </li>
          <li class="flex gap-3">
            <ChartTag label="03" />
            <span class="text-sm text-ink-2/80">SHA, NHIF and six private insurers accepted directly</span>
          </li>
        </ul>
        <a href="/about" class="mt-8 inline-block font-mono-tag text-[12px] uppercase tracking-[0.05em] text-clay hover:text-clay-dark">
          Read our full story →
        </a>
      </div>
    </div>
  </section>

  <StatsStrip />

  <section class="mx-auto max-w-8xl px-6 py-20 md:px-10 md:py-28">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end" data-reveal>
      <SectionHeading eyebrow="Our doctors" title="Meet the team you'll actually see" />
      <a href="/doctors" class="font-mono-tag text-[12px] uppercase tracking-[0.05em] text-clay hover:text-clay-dark">
        View full team →
      </a>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-10 sm:grid-cols-3">
      {featuredDoctors.map((doctor) => <DoctorCard doctor={doctor} />)}
    </div>
  </section>

  <section class="bg-grain border-y border-line-dark bg-ink">
    <div class="mx-auto max-w-8xl px-6 py-20 md:px-10 md:py-28">
      <SectionHeading eyebrow="Patient stories" title="What families across Kenya are saying" light />
      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3" data-reveal-group>
        {testimonials.map((t) => <TestimonialCard testimonial={t} />)}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-8xl px-6 py-20 md:px-10 md:py-28">
    <SectionHeading eyebrow="Find us" title="Three branches, one patient record" />
    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
      {branches.map((branch) => <BranchCard branch={branch} />)}
    </div>
  </section>

  <CTABand />
</Layout>
