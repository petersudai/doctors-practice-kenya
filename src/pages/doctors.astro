---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ChartTag from "../components/ChartTag.astro";
import DoctorCard from "../components/DoctorCard.astro";
import CTABand from "../components/CTABand.astro";
import { doctors, images } from "../data/site";

const lead = doctors.find((d) => d.lead)!;
const rest = doctors.filter((d) => !d.lead);
---

<Layout
  title="Our Doctors"
  description="Meet the physicians behind Uzima Family Clinic, led by founder Dr. Wanjiru Kamau, with specialists in internal medicine, paediatrics and dentistry."
  image={images.heroDoctors}
>
  <section class="mx-auto max-w-8xl px-6 pb-4 pt-14 md:px-10 md:pt-20" data-reveal>
    <p class="font-mono-tag text-[11px] uppercase tracking-[0.1em] text-ink-2/60">
      <span class="text-clay">[</span>Our doctors<span class="text-clay">]</span>
    </p>
    <h1 class="mt-4 max-w-2xl font-display text-5xl font-black leading-[0.95] text-balance text-ink md:text-6xl">
      The team you'll actually see
    </h1>
    <p class="mt-5 max-w-lg text-base text-ink-2/80">
      Four doctors, three branches, one shared patient record. Here's who you'll meet.
    </p>
  </section>

  <section class="mx-auto max-w-8xl px-6 py-14 md:px-10 md:py-20" data-reveal>
    <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-2 md:gap-16">
      <div class="overflow-hidden">
        <img src={lead.photo} alt={lead.name} class="aspect-[4/5] w-full object-cover" />
      </div>
      <div>
        <ChartTag label="Founder & Lead Physician" />
        <h2 class="mt-4 font-display text-3xl font-semibold text-ink md:text-4xl">{lead.name}</h2>
        <p class="font-mono-tag mt-1 text-[11px] uppercase tracking-[0.05em] text-ink-2/60">{lead.credentials}</p>
        <p class="mt-6 text-base leading-relaxed text-ink-2/80">{lead.bio}</p>
        <p class="mt-4 text-base leading-relaxed text-ink-2/80">
          Outside the clinic, Dr. Kamau chairs a monthly continuing education circle for
          GPs across Nairobi and still takes emergency calls from former patients now
          living abroad, old habits from a decade in public hospitals that never quite
          left.
        </p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {
            lead.focus.map((f) => (
              <li class="font-mono-tag border border-line px-2.5 py-1.5 text-[11px] uppercase tracking-[0.05em] text-moss">
                {f}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-paper-2 py-20 md:py-28">
    <div class="mx-auto max-w-8xl px-6 md:px-10">
      <SectionHeading eyebrow="The rest of the team" title="Specialists across medicine, paediatrics & dentistry" />
      <div class="mt-12 grid grid-cols-1 gap-10 sm:grid-cols-3">
        {rest.map((doctor) => <DoctorCard doctor={doctor} />)}
      </div>
    </div>
  </section>

  <CTABand
    heading="Pick a doctor, pick a time."
    subheading="Every doctor above sees patients at all three branches on a rotating schedule. Tell us who you'd like to see when you book."
  />
</Layout>
