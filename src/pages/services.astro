---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ChartTag from "../components/ChartTag.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CTABand from "../components/CTABand.astro";
import { services, insurers, images } from "../data/site";

const billingSteps = [
  {
    step: "01",
    title: "Tell us your cover",
    body: "Share your SHA, NHIF or private insurance details when you book, and we verify it before your visit.",
  },
  {
    step: "02",
    title: "See the doctor",
    body: "Consultations, tests and prescriptions happen in one visit wherever possible. No return trip just for results.",
  },
  {
    step: "03",
    title: "We settle the claim",
    body: "Covered costs are billed directly to your insurer. You only pay the balance, by M-Pesa, card or cash.",
  },
];
---

<Layout
  title="Services"
  description="From family consultations to dental care and diagnostics, see the full range of services at Uzima Family Clinic across Nairobi, Mombasa and Kisumu."
  image={images.heroServices}
>
  <section class="mx-auto max-w-8xl px-6 pb-4 pt-14 md:px-10 md:pt-20" data-reveal>
    <p class="font-mono-tag text-[11px] uppercase tracking-[0.1em] text-ink-2/60">
      <span class="text-clay">[</span>Services<span class="text-clay">]</span>
    </p>
    <h1 class="mt-4 max-w-2xl font-display text-5xl font-black leading-[0.95] text-balance text-ink md:text-6xl">
      Most visits are resolved in one stop
    </h1>
    <p class="mt-5 max-w-lg text-base text-ink-2/80">
      Six departments, three branches, one patient file that follows you everywhere.
    </p>
  </section>

  <section class="mx-auto max-w-8xl px-6 py-16 md:px-10 md:py-20">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service, i) => <ServiceCard service={service} detailed index={i} />)}
    </div>
  </section>

  <section class="bg-grain border-y border-line-dark bg-ink py-20 text-paper md:py-28">
    <div class="mx-auto max-w-8xl px-6 md:px-10">
      <SectionHeading eyebrow="Paying for care" title="How billing works, in three steps" light />
      <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-3" data-reveal-group>
        {
          billingSteps.map((s) => (
            <div class="border-t border-line-dark pt-5">
              <ChartTag label={s.step} light />
              <h3 class="mt-3 font-display text-lg font-semibold text-paper">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-bone/70">{s.body}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-16 border border-line-dark p-8 md:p-10" data-reveal>
        <h3 class="font-display text-xl font-semibold text-paper">Accepted cover & payment</h3>
        <ul class="mt-5 flex flex-wrap gap-2">
          {
            insurers.map((name) => (
              <li class="font-mono-tag border border-paper/25 px-3 py-1.5 text-[11px] uppercase tracking-[0.05em] text-bone">
                {name}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-20 text-center md:py-28">
    <SectionHeading
      eyebrow="First visit"
      title="What to bring to your first appointment"
      align="center"
    />
    <div class="mt-10 grid grid-cols-1 gap-6 text-left sm:grid-cols-3" data-reveal-group>
      <div class="border border-line p-6">
        <p class="text-sm font-semibold text-ink">National ID or passport</p>
        <p class="mt-2 text-sm text-ink-2/70">Required to open a patient file at any branch.</p>
      </div>
      <div class="border border-line p-6">
        <p class="text-sm font-semibold text-ink">Insurance card, if covered</p>
        <p class="mt-2 text-sm text-ink-2/70">SHA, NHIF or private cover details to verify benefits.</p>
      </div>
      <div class="border border-line p-6">
        <p class="text-sm font-semibold text-ink">Past prescriptions or results</p>
        <p class="mt-2 text-sm text-ink-2/70">Helpful but not required. We'll rebuild your history either way.</p>
      </div>
    </div>
  </section>

  <CTABand />
</Layout>
