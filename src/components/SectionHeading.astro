---
interface Props {
  eyebrow: string;
  title: string;
  align?: "left" | "center";
  light?: boolean;
}
const { eyebrow, title, align = "left", light = false } = Astro.props;
---

<div class={align === "center" ? "text-center" : "text-left"} data-reveal>
  <p class={`font-mono-tag text-[11px] uppercase tracking-[0.1em] ${light ? "text-bone/70" : "text-ink-2/60"}`}>
    <span class="text-clay">[</span>{eyebrow}<span class="text-clay">]</span>
  </p>
  <h2
    class={`mt-4 font-display text-4xl font-semibold leading-[1.03] text-balance md:text-5xl lg:text-6xl ${
      light ? "text-paper" : "text-ink"
    }`}
  >
    {title}
  </h2>
</div>
