---
interface Props {
  eyebrow: string;
  title: string;
  align?: "left" | "center";
  light?: boolean;
}
const { eyebrow, title, align = "left", light = false } = Astro.props;
---

<div class={align === "center" ? "text-center" : "text-left"}>
  <p
    class={`text-xs font-semibold uppercase tracking-[0.2em] ${
      light ? "text-gold-400" : "text-clay-600"
    }`}
  >
    {eyebrow}
  </p>
  <h2
    class={`mt-3 font-display text-3xl font-semibold text-balance md:text-4xl lg:text-5xl ${
      light ? "text-cream-50" : "text-ink-900"
    }`}
  >
    {title}
  </h2>
</div>
