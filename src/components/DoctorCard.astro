---
import type { Doctor } from "../data/site";

interface Props {
  doctor: Doctor;
}
const { doctor } = Astro.props;
---

<article class="group">
  <div class="relative aspect-[4/5] overflow-hidden rounded-lg bg-cream-300">
    <img
      src={doctor.photo}
      alt={doctor.name}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
    {
      doctor.lead && (
        <span class="absolute left-4 top-4 rounded-full bg-clay-500 px-3 py-1 text-xs font-semibold text-cream-50">
          Founder
        </span>
      )
    }
  </div>
  <h3 class="mt-5 font-display text-xl font-semibold text-ink-900">{doctor.name}</h3>
  <p class="mt-0.5 text-sm font-medium text-clay-600">{doctor.role}</p>
  <p class="mt-0.5 text-xs text-ink-500">{doctor.credentials}</p>
  <p class="mt-3 text-sm leading-relaxed text-ink-700">{doctor.bio}</p>
  <ul class="mt-4 flex flex-wrap gap-2">
    {
      doctor.focus.map((f) => (
        <li class="rounded-full bg-forest-50 px-3 py-1 text-xs font-medium text-forest-700">
          {f}
        </li>
      ))
    }
  </ul>
</article>
