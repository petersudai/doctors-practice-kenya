---
import type { Doctor } from "../data/site";

interface Props {
  doctor: Doctor;
}
const { doctor } = Astro.props;
---

<article class="group" data-reveal>
  <div class="relative aspect-[4/5] overflow-hidden bg-paper-2">
    <img
      src={doctor.photo}
      alt={doctor.name}
      loading="lazy"
      class="h-full w-full object-cover grayscale-[15%] transition-all duration-700 group-hover:scale-105 group-hover:grayscale-0"
    />
    {
      doctor.lead && (
        <span class="font-mono-tag absolute left-4 top-4 border border-paper/40 bg-ink/80 px-2.5 py-1 text-[11px] uppercase tracking-[0.08em] text-paper backdrop-blur">
          Founder
        </span>
      )
    }
  </div>
  <h3 class="mt-5 font-display text-xl font-semibold text-ink">{doctor.name}</h3>
  <p class="mt-0.5 text-sm font-medium text-clay">{doctor.role}</p>
  <p class="font-mono-tag mt-1 text-[11px] uppercase tracking-[0.05em] text-ink-2/60">{doctor.credentials}</p>
  <p class="mt-3 text-sm leading-relaxed text-ink-2/80">{doctor.bio}</p>
  <ul class="mt-4 flex flex-wrap gap-2">
    {
      doctor.focus.map((f) => (
        <li class="font-mono-tag border border-line px-2 py-1 text-[10px] uppercase tracking-[0.05em] text-moss">
          {f}
        </li>
      ))
    }
  </ul>
</article>
