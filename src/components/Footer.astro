---
import { brand, nav, branches, insurers } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="bg-ink text-bone">
  <div class="mx-auto max-w-8xl px-6 pt-20 md:px-10 md:pt-28">
    <h2 class="font-display text-[13vw] font-black leading-[0.85] tracking-tight text-paper sm:text-[10vw] md:text-[7vw]">
      Let's talk
      <span class="font-display-italic text-clay">health.</span>
    </h2>

    <div class="mt-14 grid grid-cols-1 gap-12 border-t border-line-dark pt-12 md:grid-cols-4">
      <div class="md:col-span-1">
        <a href="/" class="font-mono-tag text-base text-paper">
          <span class="text-clay">uzima</span><span class="text-pulse">·</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-bone/70">
          {brand.tagline} Family medicine, paediatrics, dental and diagnostics across three
          Kenyan cities.
        </p>
        <a
          href={`https://wa.me/${brand.whatsappNumber}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-2 rounded-full border border-paper/25 px-5 py-2.5 text-sm font-semibold text-paper transition-colors hover:bg-paper/10"
        >
          Chat on WhatsApp
        </a>
      </div>

      <div>
        <h3 class="font-mono-tag text-[11px] uppercase tracking-[0.08em] text-bone/50">
          [ Navigate ]
        </h3>
        <ul class="mt-4 space-y-2.5">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-bone/90 hover:text-clay">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="font-mono-tag text-[11px] uppercase tracking-[0.08em] text-bone/50">
          [ Branches ]
        </h3>
        <ul class="mt-4 space-y-3">
          {
            branches.map((b) => (
              <li class="text-sm text-bone/90">
                <span class="font-medium text-paper">{b.city}, {b.area}</span>
                <br />
                <span class="font-mono-tag text-xs text-bone/60">{b.phone}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="font-mono-tag text-[11px] uppercase tracking-[0.08em] text-bone/50">
          [ Cover Accepted ]
        </h3>
        <ul class="mt-4 flex flex-wrap gap-x-2 gap-y-2 text-sm text-bone/80">
          {
            insurers.map((name) => (
              <li class="border border-paper/15 px-2.5 py-1 font-mono-tag text-[11px]">{name}</li>
            ))
          }
        </ul>
        <a href={`mailto:${brand.email}`} class="mt-5 block text-sm text-bone/90 hover:text-clay">
          {brand.email}
        </a>
      </div>
    </div>

    <div class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-line-dark py-8 font-mono-tag text-[11px] uppercase tracking-[0.06em] text-bone/50 md:flex-row md:items-center">
      <p>© {year} Uzima Family Clinic — portfolio concept, not a real medical provider</p>
      <p>Nairobi · Mombasa · Kisumu</p>
    </div>
  </div>
</footer>
