---
const items = [
  { label: "SHA & NHIF accepted", detail: "National cover honoured at every branch" },
  { label: "M-Pesa payments", detail: "Pay consultation fees by till, no cash needed" },
  { label: "Private insurance", detail: "AAR, Jubilee, CIC, Britam & Madison" },
  { label: "Same-week appointments", detail: "Book via WhatsApp, call, or online form" },
];
---

<div class="border-y border-cream-300 bg-cream-200">
  <div class="mx-auto grid max-w-8xl grid-cols-2 gap-x-6 gap-y-6 px-6 py-8 md:grid-cols-4 md:px-10">
    {
      items.map((item) => (
        <div class="border-l-2 border-clay-400 pl-4">
          <p class="text-sm font-semibold text-ink-900">{item.label}</p>
          <p class="mt-1 text-xs text-ink-500">{item.detail}</p>
        </div>
      ))
    }
  </div>
</div>
