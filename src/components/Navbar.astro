---
import { nav, brand } from "../data/site";
import MobileMenu from "./MobileMenu.tsx";

const currentPath = Astro.url.pathname;
---

<header
  data-nav
  class="sticky top-0 z-30 border-b border-line-dark bg-ink transition-[padding] duration-300 [&.is-scrolled]:py-2.5 py-4"
>
  <div class="mx-auto flex max-w-8xl items-center justify-between px-6 md:px-10">
    <a href="/" class="flex items-center gap-1 font-mono-tag text-base text-paper">
      <span class="text-clay">uzima</span><span class="text-pulse">·</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        nav.map((item) => {
          const active = currentPath === item.href;
          return (
            <a
              href={item.href}
              class={`font-mono-tag relative py-1 text-[12px] uppercase tracking-[0.08em] transition-colors ${
                active ? "text-clay" : "text-bone hover:text-paper"
              }`}
            >
              {item.label}
              {active && <span class="absolute -bottom-1 left-0 h-px w-full bg-clay" />}
            </a>
          );
        })
      }
    </nav>

    <div class="hidden items-center gap-5 md:flex">
      <a href={brand.phoneHref} class="font-mono-tag text-[12px] text-bone hover:text-paper">
        {brand.phoneDisplay}
      </a>
      <a
        href="/contact"
        class="inline-flex items-center rounded-full bg-clay px-5 py-2 text-[12px] font-semibold uppercase tracking-[0.06em] text-paper transition-colors hover:bg-pulse"
      >
        Book a Visit
      </a>
    </div>

    <MobileMenu client:load />
  </div>
</header>
