---
import type { Testimonial } from "../data/site";

interface Props {
  testimonial: Testimonial;
}
const { testimonial } = Astro.props;
---

<figure class="flex h-full flex-col border-t border-line-dark pt-6" data-reveal>
  <span class="font-display text-4xl leading-none text-clay">&ldquo;</span>
  <blockquote class="mt-2 flex-1 font-display text-lg leading-snug text-paper">
    {testimonial.quote}
  </blockquote>
  <figcaption class="mt-6 flex items-center gap-3">
    <img
      src={testimonial.photo}
      alt={testimonial.name}
      loading="lazy"
      class="h-10 w-10 rounded-full object-cover grayscale"
    />
    <div>
      <p class="text-sm font-semibold text-paper">{testimonial.name}</p>
      <p class="font-mono-tag text-[11px] uppercase tracking-[0.05em] text-bone/60">{testimonial.location}</p>
    </div>
  </figcaption>
</figure>
