---
import type { Branch } from "../data/site";

interface Props {
  branch: Branch;
}
const { branch } = Astro.props;
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(branch.mapQuery)}`;
---

<article class="group relative overflow-hidden rounded-lg">
  <div class="aspect-[4/3] overflow-hidden">
    <img
      src={branch.image}
      alt={`${branch.city} skyline`}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink-900/85 via-ink-900/10 to-transparent"></div>
  </div>
  <div class="absolute inset-x-0 bottom-0 p-6 text-cream-50">
    <h3 class="font-display text-xl font-semibold">{branch.city}</h3>
    <p class="text-sm text-cream-100/80">{branch.area}</p>
    <p class="mt-3 text-xs leading-relaxed text-cream-100/70">{branch.address}</p>
    <p class="mt-1 text-xs text-cream-100/70">{branch.hours}</p>
    <div class="mt-4 flex flex-wrap gap-3">
      <a
        href={`tel:${branch.phone.replace(/\s/g, "")}`}
        class="rounded-full bg-cream-50/15 px-4 py-2 text-xs font-semibold backdrop-blur transition-colors hover:bg-cream-50/25"
      >
        {branch.phone}
      </a>
      <a
        href={mapHref}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-gold-500 px-4 py-2 text-xs font-semibold text-ink-900 transition-colors hover:bg-gold-400"
      >
        View on map
      </a>
    </div>
  </div>
</article>
