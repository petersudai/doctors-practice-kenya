---
import type { Branch } from "../data/site";

interface Props {
  branch: Branch;
}
const { branch } = Astro.props;
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(branch.mapQuery)}`;
---

<article class="group relative overflow-hidden" data-reveal>
  <div class="aspect-[4/3] overflow-hidden">
    <img
      src={branch.image}
      alt={`${branch.city} skyline`}
      loading="lazy"
      class="h-full w-full object-cover grayscale transition-all duration-700 group-hover:scale-105 group-hover:grayscale-0"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/20 to-transparent"></div>
  </div>
  <div class="absolute inset-x-0 bottom-0 p-6 text-paper">
    <p class="font-mono-tag text-[11px] uppercase tracking-[0.08em] text-bone/70">{branch.area}</p>
    <h3 class="mt-1 font-display text-2xl font-semibold">{branch.city}</h3>
    <p class="mt-3 text-xs leading-relaxed text-bone/70">{branch.address}</p>
    <p class="font-mono-tag mt-1 text-[11px] text-bone/60">{branch.hours}</p>
    <div class="mt-4 flex flex-wrap gap-3">
      <a
        href={`tel:${branch.phone.replace(/\s/g, "")}`}
        class="font-mono-tag border border-paper/30 px-4 py-2 text-[11px] backdrop-blur transition-colors hover:border-paper"
      >
        {branch.phone}
      </a>
      <a
        href={mapHref}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-clay px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.05em] transition-colors hover:bg-pulse"
      >
        View on map
      </a>
    </div>
  </div>
</article>
