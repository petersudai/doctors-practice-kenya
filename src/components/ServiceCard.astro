---
import type { Service } from "../data/site";

interface Props {
  service: Service;
  detailed?: boolean;
}
const { service, detailed = false } = Astro.props;
---

<article class="group flex flex-col overflow-hidden rounded-lg border border-cream-300 bg-cream-50 transition-shadow hover:shadow-xl hover:shadow-ink-900/5">
  <div class="aspect-[16/10] overflow-hidden">
    <img
      src={service.image}
      alt={service.name}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="font-display text-lg font-semibold text-ink-900">{service.name}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">
      {detailed ? service.detail : service.summary}
    </p>
  </div>
</article>
