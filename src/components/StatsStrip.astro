---
import { stats } from "../data/site";
---

<div class="bg-forest-800 text-cream-50">
  <div class="mx-auto grid max-w-8xl grid-cols-2 gap-8 px-6 py-14 md:grid-cols-4 md:px-10">
    {
      stats.map((s) => (
        <div>
          <p class="font-display text-4xl font-semibold text-gold-400 md:text-5xl">{s.value}</p>
          <p class="mt-2 text-sm text-cream-100/80">{s.label}</p>
        </div>
      ))
    }
  </div>
</div>
