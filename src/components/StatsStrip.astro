---
import { stats } from "../data/site";
---

<div class="border-t border-line-dark bg-ink text-paper">
  <div class="mx-auto grid max-w-8xl grid-cols-2 gap-8 px-6 py-16 md:grid-cols-4 md:px-10" data-reveal-group>
    {
      stats.map((s) => (
        <div class="border-l border-line-dark pl-4">
          <p class="font-display text-4xl font-semibold text-clay md:text-5xl">{s.value}</p>
          <p class="font-mono-tag mt-2 text-[11px] uppercase tracking-[0.05em] text-bone/70">{s.label}</p>
        </div>
      ))
    }
  </div>
</div>
