---
import { brand } from "../data/site";

interface Props {
  heading?: string;
  subheading?: string;
}
const {
  heading = "Ready when you are.",
  subheading = "Book a same-week appointment at any of our three branches, by WhatsApp, phone, or the form below.",
} = Astro.props;
---

<section class="border-t border-line-dark bg-clay text-paper" data-reveal>
  <div class="mx-auto max-w-8xl px-6 py-20 text-center md:px-10 md:py-28">
    <h2 class="font-display text-3xl font-semibold text-balance md:text-4xl lg:text-5xl">
      {heading}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-paper/90">{subheading}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/contact"
        class="rounded-full bg-ink px-7 py-3.5 text-sm font-semibold text-paper transition-colors hover:bg-ink-2"
      >
        Book an Appointment
      </a>
      <a
        href={`https://wa.me/${brand.whatsappNumber}`}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full border border-paper/60 px-7 py-3.5 text-sm font-semibold text-paper transition-colors hover:bg-paper/10"
      >
        Chat on WhatsApp
      </a>
    </div>
  </div>
</section>
