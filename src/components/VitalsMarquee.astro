---
import { stats } from "../data/site";

const items = [
  "NAIROBI · MOMBASA · KISUMU",
  `${stats[1].value} PATIENTS SEEN`,
  "FOUNDED 2011",
  "SHA / NHIF / M-PESA ACCEPTED",
  `${stats[3].value} RETURN OR REFER`,
  "20-MIN MINIMUM CONSULTATION",
];
const track = [...items, ...items];
---

<div class="border-b border-line-dark bg-ink font-mono-tag text-[11px] uppercase text-bone">
  <div class="flex overflow-hidden">
    <div class="marquee-track">
      {
        track.map((item) => (
          <span class="flex items-center gap-8 whitespace-nowrap py-2 pr-8">
            <span>{item}</span>
            <span class="pulse-dot inline-block h-1.5 w-1.5 rounded-full bg-pulse" aria-hidden="true" />
          </span>
        ))
      }
    </div>
  </div>
</div>
